{
  "manifest_version": 3,
  "name": "Job Tracker Pro",
  "version": "2.0.0",
  "description": "Smart job application tracker. Auto-detects when you apply, captures full job details, tracks everything in Google Sheets.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "quick-track": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "Quick-track the current page as a job application"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.lever.co/*",
        "*://*.greenhouse.io/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.dice.com/*",
        "*://*.monster.com/*",
        "*://*.angel.co/*",
        "*://*.wellfound.com/*",
        "*://*.builtin.com/*",
        "*://*.simplyhired.com/*",
        "*://*.careerbuilder.com/*",
        "*://*.careers.*/*",
        "*://*.jobs.*/*"
      ],
      "js": ["extractors.js", "content.js"],
      "css": ["content-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}

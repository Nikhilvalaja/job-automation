# =============================================================================
# Job Automation Ecosystem — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# =============================================================================

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# --- Google Sheets ---
# Path to your Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# The Google Sheet ID (from the sheet URL: https://docs.google.com/spreadsheets/d/{THIS_PART}/edit)
GOOGLE_SHEET_ID=your_sheet_id_here
# Worksheet name (tab name in the sheet)
GOOGLE_WORKSHEET_NAME=Applications

# --- Gmail API (OAuth 2.0) ---
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- OpenAI (Cover Letter Generator) ---
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o

# --- Scheduling ---
EMAIL_BOT_INTERVAL_MINUTES=5
REMINDER_BOT_HOUR=9
REMINDER_BOT_MINUTE=0
DISCOVERY_BOT_INTERVAL_MINUTES=30
FOLLOWUP_THRESHOLD_DAYS=7

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
